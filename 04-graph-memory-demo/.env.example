# OpenAI API key — used by BOTH the chat model (gpt-4o-mini) and the embedding
# model (text-embedding-3-small) for the graph's vector index.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Neo4j connection. Works with a local Neo4j (Desktop or Docker) or Neo4j Aura —
# only NEO4J_URI changes. Use neo4j:// for local, neo4j+s:// for Aura.
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# Database for this demo. On Neo4j Enterprise the demo creates an isolated database
# with this name so it never touches your other graphs. On Neo4j Community (single
# database) the demo falls back to the default database automatically.
NEO4J_DATABASE=memorydemo

# Optional: override the embedding model (default: text-embedding-3-small)
# EMBED_MODEL=text-embedding-3-small

# To run on Amazon Bedrock instead (Titan embeddings + a Bedrock chat model),
# no OpenAI key is needed — configure AWS credentials (aws configure) and
# uncomment the Bedrock blocks in test_graph_memory.py and graph_memory.py.
