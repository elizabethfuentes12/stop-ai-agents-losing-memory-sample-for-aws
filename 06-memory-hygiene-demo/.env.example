# OpenAI API key — used by the model (gpt-4o-mini) and, for the graph track, the
# embedding model (text-embedding-3-small).
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Neo4j connection (needed only for the graph track — the key-value track runs without it).
# Works with a local Neo4j (Desktop or Docker) or Neo4j Aura — only NEO4J_URI changes.
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# Isolated database for this demo's graph track. On Neo4j Enterprise the demo creates it
# so it never touches your other graphs; on Community it falls back to the default database.
HYGIENE_NEO4J_DATABASE=hygienedemo

# Optional: override the embedding model (default: text-embedding-3-small)
# EMBED_MODEL=text-embedding-3-small

# To run on Amazon Bedrock instead (Titan embeddings + a Bedrock chat model),
# no OpenAI key is needed — configure AWS credentials (aws configure) and
# uncomment the Bedrock blocks in test_memory_hygiene.py and hygiene_graph.py.
