# OpenAI API key — the conversational agent (mechanism A) and the extractor (B).
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# AWS credentials (aws configure) power:
#   - Titan Text Embeddings V2 via Amazon Bedrock (mechanism B)
#   - Amazon S3 Vectors — 4 indexes, one per memory type (mechanism B)
#   - Amazon Bedrock AgentCore Memory — created with the 4 built-in strategies (mechanism C)
# ALL resources are created automatically if they don't exist.
VECTOR_BUCKET=agent-memory-demo-vectors
AGENTCORE_MEMORY_NAME=SelectiveMemoryDemo
# AWS_PROFILE=your-profile   # optional; default credential chain otherwise
# EXTRACTOR_MODEL=gpt-4o-mini   # the extractor (B) is independent of the chat model
