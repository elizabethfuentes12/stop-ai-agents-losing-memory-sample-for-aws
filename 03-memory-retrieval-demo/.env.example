# OpenAI API key — used by BOTH the model provider (gpt-4o-mini) and the
# embedding model (text-embedding-3-small) for semantic search.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Optional: override the embedding model (default: text-embedding-3-small)
# EMBED_MODEL=text-embedding-3-small

# To run on Amazon Bedrock instead (Titan embeddings + a Bedrock chat model),
# no OpenAI key is needed — configure AWS credentials (aws configure) and
# uncomment the Bedrock blocks in tools.py and the test file.
