# OpenAI API key — used only by the agent conversation in the notebook
# (the retrieval measurements need no LLM).
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# AWS credentials (aws configure) power BOTH:
#   - Titan Text Embeddings V2 via Amazon Bedrock (both vector backends)
#   - Amazon S3 Vectors (managed vector storage)
# The demo creates the vector bucket + index automatically if they don't exist.
# Vector bucket names are unique per account+region.
VECTOR_BUCKET=agent-memory-demo-vectors
VECTOR_INDEX=traveler-memories
# AWS_PROFILE=your-profile   # optional; default credential chain otherwise
