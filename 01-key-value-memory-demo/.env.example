# OpenAI API key, used by the default model provider (gpt-4o-mini).
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Duffel flight-search sandbox token (free), powers the live flight offers.
# Create one at https://app.duffel.com (More -> Developers -> Access tokens).
DUFFEL_API_KEY=duffel_test_your-token-here

# Climate data (Open-Meteo) needs no key.

# To run on Amazon Bedrock instead, no OpenAI key is needed, configure AWS
# credentials (aws configure) and edit the model block at the top of the test file.

# Optional (Test 4): a bucket name for cloud session storage via S3SessionManager
# (plain JSON objects, regular S3, no vectors). Created automatically if it
# doesn't exist (private). Requires AWS credentials (aws configure).
# Bucket names are globally unique, include your account id or a suffix.
SESSIONS_BUCKET=your-bucket-name
