# OpenAI API key — the chat agent and the native ModelExtractor (mechanisms A & B).
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# AWS credentials (aws configure) power:
#   - Titan Text Embeddings V2 via Amazon Bedrock (the VectorMemoryStore, A & B)
#   - The vector backend — Amazon S3 Vectors OR Amazon DynamoDB Vector Search (A & B)
#   - Amazon Bedrock AgentCore Memory — created with the 4 built-in strategies (C)
# ALL resources are created automatically if they don't exist.
VECTOR_BUCKET=agent-memory-demo-vectors
AGENTCORE_MEMORY_NAME=SelectiveMemoryDemo
# AWS_PROFILE=your-profile   # optional; default credential chain otherwise

# ── Native Strands memory (mechanisms A & B) ─────────────────────────────────
# The ModelExtractor that performs selection is independent of the chat model.
# EXTRACTOR_MODEL=gpt-4o-mini        # model for the native ModelExtractor
# EXTRACTION_INTERVAL=1              # IntervalTrigger cadence: extract every N turns

# ── Vector backend for the VectorMemoryStore (mechanisms A & B) ──────────────
# s3 (default) = Amazon S3 Vectors, one index per store partition inside VECTOR_BUCKET.
# dynamodb     = Amazon DynamoDB Vector Search, one table per store partition
#                (DYNAMODB_TABLE_PREFIX-<partition>) with a native vector index.
#                Requires boto3 >= 1.43.72 (SearchVectors API).
# VECTOR_BACKEND=s3
# DYNAMODB_TABLE_PREFIX=selective-memory
# DYNAMODB_VECTOR_INDEX=memory-vector-index
# DYNAMODB_VECTOR_ATTR=embedding
